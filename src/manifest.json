{
  "manifest_version": 3,
  "minimum_chrome_version": "120",
  "name": "日语汉字 AI 读音助手",
  "version": "2.3.0",
  "description": "为日语网页添加平假名读音，并使用用户配置的 OpenAI 兼容接口翻译选中的词、句子或段落。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "启用日语读音与划词翻译",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "dict/*.gz"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
